# --- Database (server only; NEVER prefix with NEXT_PUBLIC_) ---
# Any MySQL 5.7 / 8.x host. Hosted databases need TLS: add ?ssl=true (or set DATABASE_SSL=true).
DATABASE_URL=mysql://user:password@host:3306/swasthtrack
# Optional: DATABASE_SSL=true, DATABASE_SSL_CA=<PEM text or file path>, DATABASE_POOL_SIZE=5

# --- Sign-in (server only) ---
# Random string of 32+ characters: openssl rand -hex 32
# Keys the hash of e-mailed sign-in codes and the rate-limit counters.
AUTH_SECRET=

# Public address of the app (e.g. https://swasthtrack.vercel.app). E-mails use it for the logo (/email/logo.png),
# the buttons and the footer links; without it they still send, just without those.
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# --- Ask / SOIE (server-only; NEVER prefix with NEXT_PUBLIC_) ---
# Ask answers through the AI providers configured in the next block and, with none of them (or with the family's
# AI switch off), from the app's own rules, saying so on screen. Details: docs/soie.md.
# Max Ask questions per user per hour (abuse / cost guard).
SOIE_RATE_LIMIT_PER_HOUR=40
# Set to "false" to switch internet search off.
SOIE_WEB_SEARCH=true
# Request timeout in ms (10000-110000). Thinking depth: SOIE_EFFORT=low|medium|high (default medium).
SOIE_TIMEOUT_MS=100000
# Ask uses the AI providers below (Google, Groq, OpenRouter). Claude / Anthropic is not supported.

# --- AI providers (server-only; NEVER prefix with NEXT_PUBLIC_) ---
# Photo reading, Ask, daily summaries, trend notes, voice. Any ONE key is enough; with several the app tries them
# in order and falls back automatically (a busy or rate-limited model never blocks an answer). Without any key
# every AI feature quietly falls back to the app's own rules, and Settings > AI says AI is not turned on.
# On Vercel add each variable for Production AND Preview, then Redeploy. Rotate a key by adding the new one as
# GEMINI_API_KEY_2, redeploying, then removing the old one. Full reference: docs/ai.md.
#   Gemini : https://aistudio.google.com/apikey        Groq : https://console.groq.com/keys
#   OpenRouter : https://openrouter.ai/keys (the free ':free' models only; 50 requests a day)
GEMINI_API_KEY=
# More keys for the same provider rotate automatically: GEMINI_API_KEY_2=..., or GEMINI_API_KEYS=key1,key2
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional
# AI_ENABLED=false                     switch every AI call off (the app runs on its own rules)
# AI_FEATURES_OFF=brief,trend,voice    switch single features off by task-name prefix (list in docs/ai.md)
# AI_PROVIDER_ORDER=gemini,groq,openrouter
# Where health content may go. balanced (default): providers that do not train on content come first and the
# others stay as fallbacks. strict: health content never reaches a provider that may train on it (a free
# Gemini or OpenRouter key then serves only generic text; health features use Groq, or the rules without a
# Groq key). performance: ignore sensitivity.
# AI_PRIVACY=balanced
# Set to paid ONLY if billing is enabled on that key's Google/OpenRouter project: it tells the app that the
# provider's terms do not allow training on your content. Never set it to look better: the app then sends
# health content to that provider first and lets AI_PRIVACY=strict use it.
# GEMINI_PLAN=paid
# OPENROUTER_PLAN=paid
# AI_RATE_LIMIT_PER_HOUR=120           model-calling requests per signed-in user per hour
# AI_PATIENT_DAILY_LIMIT=400           per patient per day (daily summaries stop at 60 % so photos and voice keep a reserve)
# AI_GLOBAL_DAILY_LIMIT=2000           whole deployment per day
# AI_TIMEOUT_MS=30000
# GROQ_MAX_INPUT_TOKENS=6000           bigger prompts skip Groq (free tier: about 8,000 tokens a minute)
# GEMINI_MODELS_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_MODELS_SMART=gemini-3.8-flash,gemini-3.7-flash
# GROQ_MODELS_SMART=openai/gpt-oss-120b   GROQ_MODELS_VISION=qwen/qwen3.8-27b   GROQ_STT_MODEL=whisper-large-v3-turbo

# --- E-mail via Resend SMTP (server-only): sign-in codes, alerts, daily/weekly reports ---
# In production, sign-up needs this to work. EMAIL_FROM must be on a domain you verified in Resend;
# the sandbox sender onboarding@resend.dev only delivers to the Resend account owner's own address.
# In development, leave SMTP_PASS / RESEND_API_KEY empty and the sign-in code is printed in the server console.
RESEND_API_KEY=re_your_resend_api_key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
EMAIL_FROM="SwasthTrack <noreply@your-verified-domain>"
# Alerts and reports go to each patient's owner and caregivers automatically. This one is only where the
# "send me the sample e-mails" preview tool delivers, comma-separated (optional).
REPORT_EMAIL_TO=you@example.com
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"; generate with: openssl rand -hex 24
CRON_SECRET=generate-a-long-random-string

# --- One-time data copy from the old Supabase project (scripts/db/migrate-from-supabase.mjs). Optional. ---
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=public anon key (works while the old open access rules are still on) or a service-role key

# E-mail: medicine pattern notes and yesterday's left-over doses in the reports and the 2 PM reminder (code only, no AI).
# Set to "off" to send exactly the mails that existed before they were added.
# EMAIL_MEDICINE_PATTERNS=on
