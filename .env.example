# Supabase Public Configuration (Required for client-side and server-side data access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# Optional Application URL (e.g., https://swasthtrack.vercel.app or custom domain)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
